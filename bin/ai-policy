#!/usr/bin/env bash
# ai-policy <org/repo> - classify a project's AI policy BEFORE contributing.
#
# Exists because a technically correct contribution to pallets/click was closed as
# "AI junk": the policy was not in the repository but in the organisation's .github,
# and on the project site. Reading only the repository is not enough.
#
# Salida: FORBIDDEN | DISCLOSE | RESPONSIBLE-USE | NO-POLICY  + las frases que lo deciden.
set -uo pipefail

if (($# != 1)) || [[ ! $1 =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
  echo "usage: ai-policy OWNER/REPO" >&2
  exit 2
fi

repo=$1
org=${repo%%/*}

api_error() {
  printf 'API ERROR  %s\n' "$1" >&2
  return 2
}

# The raw media type avoids a platform-specific base64 decoder. A missing file
# is expected while probing the known policy locations; every other API failure
# must stop the audit so that missing evidence cannot become NO-DOCS.
leer() {
  local owner=$1
  local path=$2
  local response

  if response=$(gh api "repos/$owner/contents/$path" \
    -H 'Accept: application/vnd.github.raw+json' 2>&1); then
    printf '%s\n' "$response"
    return 0
  fi

  if [[ $response == *"HTTP 404"* ]]; then
    return 4
  fi

  api_error "cannot read $owner/$path: $response"
}

agregar_fuente() {
  local owner=$1
  local path=$2
  local content
  local status

  if content=$(leer "$owner" "$path"); then
    if [[ -n $content ]]; then
      corpus+="$content"$'\n'
      fuentes+=("$owner/$path")
    fi
    return 0
  else
    status=$?
  fi

  [[ $status == 4 ]] && return 0
  return "$status"
}

corpus=""; fuentes=()
# 1. ORGANISATION level - the source people skip, and the one that closed the Click PR.
for f in CONTRIBUTING.md AI_POLICY.md POLICY.md profile/README.md; do
  agregar_fuente "$org/.github" "$f" || exit 2
done
# 2. REPOSITORY level.
for f in CONTRIBUTING.md CONTRIBUTING.rst .github/CONTRIBUTING.md AI_POLICY.md AGENTS.md \
         CODE_OF_CONDUCT.md .github/PULL_REQUEST_TEMPLATE.md .github/pull_request_template.md \
         docs/contributing.md docs/contributing.rst docs/CONTRIBUTING.md \
         Documentation/HOWTO-CONTRIBUTING.md; do
  agregar_fuente "$repo" "$f" || exit 2
done
# 3. The project site linked from the repo (Pallets publishes its ban there).
if ! web=$(gh api "repos/$repo" --jq '.homepage // empty' 2>&1); then
  api_error "cannot read repository metadata for $repo: $web"
  exit 2
fi

if [ -z "$corpus" ]; then echo "NO-DOCS  $repo"; [ -n "$web" ] && echo "  revisar a mano: $web"; exit 0; fi

clasifica() { grep -Eiq "$1" <<<"$corpus"; }
# Unambiguous prohibitions only. No optional "(not )?": Rust's policy says
# "LLM contributions are not banned", and an optional "not" inverts it.
if   clasifica 'closed on sight|likely to be blocked|we do not (accept|allow) (AI|LLM)|(AI|LLM)[a-z -]{0,30}(contributions|PRs|pull requests)[^.]{0,20} (are|is) (banned|prohibited|forbidden|not accepted)'
then estado="FORBIDDEN"
elif clasifica 'must disclose|MUST disclose|disclosure \(required\)|please disclose|Assisted-by|Co-authored-by.{0,30}trailer|AI Disclosure'
then estado="DISCLOSE"
elif clasifica 'LLM|AI[- ]generated|AI tools|generative AI|Copilot|ChatGPT|AI (coding )?agents?|AI models?'
then estado="RESPONSIBLE-USE"
else estado="NO-POLICY"
fi

# A legal rule separate from permission: systemd and util-linux accept AI-assisted
# work but forbid crediting it in the commit - the opposite of what pytest asks for.
if clasifica '[Oo]nly human beings can (ever )?be credited|no Co-Developed-By or Co-Authored-By'
then estado="$estado  [NO-AI-CREDIT: do not add Co-authored-by or Assisted-by for a model]"
fi

echo "$estado  $repo"
printf '  source: %s\n' "${fuentes[@]}"
[ -n "$web" ] && echo "  site:   $web  (check /contributing by hand)"
echo "  deciding phrases:"
grep -Eio ".{0,110}(closed on sight|must disclose|Assisted-by|Co-authored-by|likely to be blocked|autonomous agents|AI[- ]generated|AI tools|LLM).{0,110}" <<<"$corpus" \
  | sed 's/[[:space:]]\+/ /g' | sort -u | head -6 | sed 's/^/    · /'
exit 0
