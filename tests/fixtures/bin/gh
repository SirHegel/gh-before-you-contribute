#!/usr/bin/env bash
# Deterministic GitHub CLI double for the integration test suite.
set -uo pipefail

scenario=${GH_FIXTURE:-ready}

if [[ ${1-} != "api" ]]; then
  printf 'unexpected command: %s\n' "$*" >&2
  exit 90
fi
shift
endpoint=${1-}
shift || true
arguments=" $* "

case "$endpoint" in
  repos/acme/project)
    if [[ $scenario == "metadata-api-error" && $arguments == *" --jq "* ]]; then
      printf '%s\n' 'gh: service unavailable (HTTP 503)' >&2
      exit 1
    elif [[ $arguments == *" --jq "* ]]; then
      printf '%s\n' 'https://example.test/project'
    else
      printf '%s\n' '{"full_name":"acme/project"}'
    fi
    ;;
  repos/acme/.github/contents/*)
    if [[ $scenario == "policy-api-error" && $endpoint == "repos/acme/.github/contents/CONTRIBUTING.md" ]]; then
      printf '%s\n' 'gh: forbidden (HTTP 403)' >&2
      exit 1
    fi
    printf '%s\n' 'gh: Not Found (HTTP 404)' >&2
    exit 1
    ;;
  repos/acme/project/contents/CONTRIBUTING.md)
    if [[ $scenario == "no-docs" ]]; then
      printf '%s\n' 'gh: Not Found (HTTP 404)' >&2
      exit 1
    elif [[ $scenario == "blocked" ]]; then
      printf '%s\n' 'AI-generated pull requests are forbidden.'
    else
      printf '%s\n' 'AI tools are allowed, but contributors must disclose their use.'
    fi
    ;;
  repos/acme/project/contents/*)
    printf '%s\n' 'gh: Not Found (HTTP 404)' >&2
    exit 1
    ;;
  repos/acme/project/issues/42)
    case "$scenario" in
      closed)
        printf '%s\n' '{"user":{"login":"octocat"},"state":"closed","assignee":null,"title":"Repair the flux capacitor","body":"Please add a regression test."}'
        ;;
      assigned)
        printf '%s\n' '{"user":{"login":"octocat"},"state":"open","assignee":{"login":"maintainer"},"title":"Repair the flux capacitor","body":"Please add a regression test."}'
        ;;
      *)
        printf '%s\n' '{"user":{"login":"octocat"},"state":"open","assignee":null,"title":"Repair the flux capacitor","body":"Please add a regression test."}'
        ;;
    esac
    ;;
  repos/acme/project/issues/42/timeline)
    if [[ $scenario == "api-error" || $scenario == "assigned" ]]; then
      printf '%s\n' 'simulated timeline failure' >&2
      exit 1
    elif [[ $scenario == "blocked" ]]; then
      printf '%s\n' '[{"event":"cross-referenced","source":{"issue":{"number":43,"title":"Fixes 42","state":"open","created_at":"2026-08-27T00:00:00Z","user":{"login":"contributor"},"pull_request":{}}}}]'
    else
      printf '%s\n' '[]'
    fi
    ;;
  search/issues\?q=*)
    if [[ $arguments == *" --jq "* ]]; then
      :
    else
      printf '%s\n' '{"items":[]}'
    fi
    ;;
  repos/acme/project/issues/42/comments)
    printf '%s\n' '[]'
    ;;
  *)
    printf 'unexpected endpoint: %s\n' "$endpoint" >&2
    exit 91
    ;;
esac
